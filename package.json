{
  "name": "game-trades-club",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bunx concurrently \"bun run server\" \"bun run client\"",
    "client": "cd apps/web && bunx vite --host 0.0.0.0",
    "server": "bun run apps/api/src/index.ts",
    "build": "cd apps/web && bunx vite build",
    "preview": "cd apps/web && bunx vite preview",
    "games:load": "bun run scripts/load_games.ts",
    "games:refresh": "bun run scripts/refresh_game_ranks.ts",
    "typecheck": "bunx tsc --noEmit -p apps/web/tsconfig.json && bunx tsc --noEmit -p apps/api/tsconfig.json",
    "test": "bun test --preload ./apps/web/test/setup.ts",
    "lint": "bunx eslint .",
    "format": "bunx eslint . --fix && bunx prettier --write --ignore-unknown .",
    "format:check": "bunx eslint . && bunx prettier --check --ignore-unknown ."
  },
  "dependencies": {
    "@std/csv": "npm:@jsr/std__csv",
    "leaflet": "^1.9.4",
    "preact": "^10.26.9",
    "preact-iso": "^2.11.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.8",
    "@preact/preset-vite": "^2.10.2",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/leaflet": "^1.9.21",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.5",
    "eslint-config-preact": "^2.0.0",
    "eslint-plugin-jsdoc": "^61.7.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4"
  }
}
